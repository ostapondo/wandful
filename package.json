{
  "name": "wandful",
  "private": true,
  "version": "0.0.2",
  "description": "Mouse gestures that fire keyboard shortcuts: draw a shape, the shortcut you bound to it is typed into the app you were in",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostapondo/wandful.git"
  },
  "homepage": "https://github.com/ostapondo/wandful#readme",
  "bugs": {
    "url": "https://github.com/ostapondo/wandful/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "tauri": "tauri",
    "build:mac": "tauri build && sh scripts/sign-mac.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
